# Copy this file to .env.local and fill in the values from your Supabase project.
# Project Settings -> API. Both values below are PUBLIC and safe to ship to a browser:
# the RLS policies in supabase/migrations are what actually enforce access control.
#
# DO NOT put the service_role key or the Google client secret here.
# Those stay in the Supabase Dashboard / server-side environment only.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

